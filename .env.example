# Used by docker-compose.prod.yml only. Copy to .env (never commit it).
POSTGRES_PASSWORD=change-me-to-a-long-random-password
HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080
# true once the site is served over HTTPS
COOKIE_SECURE=false
# false skips downloading the embedding/reranker models at build time (they download on first use instead)
PRELOAD_MODELS=true
