# Copy to .env and fill in. Never commit .env.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+psycopg://corpmind:corpmind_dev@localhost:5432/corpmind

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOW_SELF_REGISTRATION=true
# Restrict self-registration to your company's email domains (comma-separated). Strongly recommended.
REGISTRATION_EMAIL_DOMAINS=

# --- Rate limits ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=20/minute

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=20

# --- Embeddings / vector store ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Retrieval ---
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=20
RELEVANCE_THRESHOLD=0.30          # min cosine similarity (used when the reranker is off)
RERANK_THRESHOLD=0.10             # min cross-encoder relevance 0..1 (used when the reranker is on)
MAX_CHUNKS_PER_DOCUMENT=4
SUMMARY_MAX_CHARS=14000
CHAT_HISTORY_TURNS=6

# --- LLM (switch provider by changing these three lines) ---
# Recommended free option: Groq (https://console.groq.com, key starts with gsk_).
# Model names change: if you get "model_not_found", pick a current one from the Groq console.
#   LLM_PROVIDER=groq          LLM_MODEL=openai/gpt-oss-120b
#   LLM_PROVIDER=openai        LLM_MODEL=gpt-4o-mini                (key starts with sk-, needs credit)
#   LLM_PROVIDER=anthropic     LLM_MODEL=claude-haiku-5-5
#   LLM_PROVIDER=google_genai  LLM_MODEL=<from Google AI Studio>    (pip install langchain-google-genai)
#   LLM_PROVIDER=ollama        LLM_MODEL=llama3.1                   (pip install langchain-ollama; no key, runs locally)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048        # reasoning models (e.g. gpt-oss) need room to think before answering
OLLAMA_BASE_URL=http://localhost:11434

# --- Initial admin (used by: python -m app.scripts.create_admin) ---
FIRST_ADMIN_EMAIL=admin@corpmind.local
FIRST_ADMIN_PASSWORD=
